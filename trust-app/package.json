{
  "name": "klio-trust-app",
  "version": "0.0.1",
  "private": true,
  "description": "Klio's local-first dashboard for browsing memories, spaces, and access requests. Part of the Klio open-source project.",
  "homepage": "https://klio.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klio-tech/klio.git",
    "directory": "trust-app"
  },
  "bugs": {
    "url": "https://github.com/klio-tech/klio/issues"
  },
  "author": {
    "name": "Abhishek Singh",
    "email": "contact@klio.tech",
    "url": "https://klio.tech"
  },
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "klio",
    "ai-agents",
    "memory",
    "mcp",
    "next.js",
    "dashboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "KLIO_BUILD_TARGET=${KLIO_BUILD_TARGET:-local} next dev -p 3000",
    "dev:local": "KLIO_BUILD_TARGET=local next dev -p 3000",
    "dev:public": "KLIO_BUILD_TARGET=public next dev -p 3001",
    "build": "KLIO_BUILD_TARGET=${KLIO_BUILD_TARGET:-local} npm run build:${KLIO_BUILD_TARGET:-local}",
    "build:local": "node scripts/select-target.mjs local && (KLIO_BUILD_TARGET=local next build; status=$?; node scripts/restore-targets.mjs; exit $status)",
    "build:public": "node scripts/select-target.mjs public && (KLIO_BUILD_TARGET=public next build; status=$?; node scripts/restore-targets.mjs; exit $status)",
    "restore-targets": "node scripts/restore-targets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:bundle-isolation": "node scripts/check-bundle-isolation.mjs"
  },
  "dependencies": {
    "jose": "5.9.6",
    "next": "^16.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "ignore-loader": "^0.1.2",
    "typescript": "5.6.3"
  }
}
