# next@15.0.3's peer dep on react was tagged before stable React 19
# shipped, so it lists `^18.2.0 || 19.0.0-rc-...`. With React 19.0.0
# stable in our deps, npm 10+ refuses to resolve under strict mode.
# Relaxing this here makes `npm ci` (in Docker) match what `npm install`
# does locally. Bumping next to >=15.1 would also fix it; we keep
# legacy-peer-deps to avoid an unrelated upgrade in the same change.
legacy-peer-deps=true
