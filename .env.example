# Local-dev environment for the trust-app docker service.
#
# After running `klio init`, copy this file to `.env` and fill in the
# values from `klio status` output:
#
#   cp .env.example .env
#   /tmp/klio status   # prints user_id and agent_id
#
# The trust-app uses these to mint a JWT on its own (no magic-link
# round-trip required for self-hosters). The JWT is signed with
# KLIO_JWT_SIGNING_KEY, which must match what the engine uses.

KLIO_JWT_SIGNING_KEY=dev-secret
KLIO_LOCAL_USER_ID=
KLIO_LOCAL_AGENT_ID=
