# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
dist/
build/
*.egg

# Go
bin/
# But the npm package's bin/ holds the published CLI entry point —
# keep it tracked. Without this exception the gitignore rule above
# silently strips bin/klio.mjs from `npm publish`, and `npx
# @klio-tech/klio init` errors with "klio: command not found"
# because the published tarball has no executable.
!npm/bin/
*.test
*.out
vendor/

# Node
node_modules/
.next/
.turbo/
*.tsbuildinfo
.pnpm-store/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Klio runtime
.klio/
*.klio-backup-*
